<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Brainrot RNG — Roll the weird</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{--bg:#090b12;--panel:#111522;--line:#272d40;--muted:#8c94aa;--text:#f1f3fa;--lime:#d5ff5f;--pink:#ff72b6;--cyan:#6be4dc}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#28304c 0,transparent 48%),var(--bg);color:var(--text);font-family:'Space Grotesk',sans-serif;min-height:100vh}
button{font:inherit;color:inherit;cursor:pointer}.wrap{max-width:1160px;margin:auto;padding:26px 32px 50px}.top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:20px}.brand{display:flex;align-items:center;gap:12px;font-size:18px;font-weight:700;letter-spacing:-.5px}.brand-icon{width:38px;height:38px;border:1px solid #52603a;background:#28341d;border-radius:12px;display:grid;place-items:center;font-size:21px}.brand small{font:10px 'DM Mono',monospace;color:var(--lime);display:block;letter-spacing:2px;margin-top:2px}.top-right{display:flex;align-items:center;gap:10px}.pill{border:1px solid var(--line);background:#111522;border-radius:99px;padding:9px 14px;color:#c7cbd7;font:11px 'DM Mono',monospace}.pill b{color:var(--lime);font-weight:500}.sound{width:38px;height:38px;border:1px solid var(--line);background:#111522;border-radius:50%;font-size:16px}
.hero{text-align:center;padding:47px 0 29px}.eyebrow{font:10px 'DM Mono',monospace;text-transform:uppercase;color:var(--lime);letter-spacing:3px}.hero h1{font-size:clamp(39px,6vw,70px);letter-spacing:-4px;line-height:.98;margin:14px 0 12px}.hero h1 span{color:var(--lime)}.hero p{color:var(--muted);font-size:14px;margin:0}
.game{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:18px}.stage{border:1px solid var(--line);background:linear-gradient(140deg,#171c2b,#10131d 75%);border-radius:18px;min-height:420px;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px}.stage:before,.stage:after{content:'';position:absolute;width:300px;height:300px;border-radius:50%;filter:blur(85px);opacity:.12;pointer-events:none}.stage:before{background:var(--lime);top:-200px;left:20%}.stage:after{background:#7d6aff;bottom:-220px;right:10%}.stage-top{position:absolute;top:18px;left:20px;right:20px;display:flex;justify-content:space-between;color:#7e879e;font:10px 'DM Mono',monospace;letter-spacing:1px}.live{color:var(--lime)}.orb{width:190px;height:190px;border-radius:50%;display:grid;place-items:center;position:relative;margin:8px 0 19px;transition:.3s}.orb-ring{position:absolute;inset:0;border-radius:50%;border:1px solid #687052;box-shadow:0 0 50px #d5ff5f16,inset 0 0 36px #d5ff5f0d;animation:spin 18s linear infinite}.orb-ring:before,.orb-ring:after{content:'';position:absolute;width:7px;height:7px;border-radius:50%;background:var(--lime);top:13px;left:37px;box-shadow:0 0 13px var(--lime)}.orb-ring:after{top:auto;left:auto;right:10px;bottom:56px;width:4px;height:4px}.orb-face{font-size:88px;filter:drop-shadow(0 14px 20px #0009);z-index:1;transition:transform .15s}.orb.idle .orb-face{animation:bob 3s ease-in-out infinite}.stage h2{font-size:20px;margin:0 0 5px;letter-spacing:-.5px}.stage .sub{font:11px 'DM Mono',monospace;color:#8e96aa;margin:0}.roll{margin-top:21px;background:var(--lime);color:#10130a;border:0;border-radius:10px;padding:14px 32px;font-size:13px;font-weight:700;box-shadow:0 4px 22px #d5ff5f22;transition:.2s}.roll:hover{transform:translateY(-2px);box-shadow:0 8px 28px #d5ff5f3b}.roll:disabled{opacity:.65;cursor:wait}.hint{margin-top:12px;color:#737b90;font:10px 'DM Mono',monospace}.sidebar{border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:20px}.side-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.side-head h3{font-size:13px;margin:0}.side-head span{font:10px 'DM Mono',monospace;color:#8991a5}.stat{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #242a39;font-size:11px;color:#aeb4c4}.stat b{color:#f1f3fa;font:11px 'DM Mono',monospace}.stat b.green{color:var(--lime)}.odds-title{font:9px 'DM Mono',monospace;color:#747c90;letter-spacing:1.5px;margin:21px 0 10px}.odds{display:grid;gap:8px}.odds-row{display:flex;align-items:center;justify-content:space-between;font-size:10px}.rarity{display:flex;align-items:center;gap:7px;color:#c9ceda}.dot{width:7px;height:7px;border-radius:50%;background:var(--rarity)}.odds-row code{font:10px 'DM Mono',monospace;color:#8c94a8}.tip{margin-top:18px;padding:11px;border:1px solid #30374c;border-radius:9px;background:#171c2b;color:#8991a5;font-size:10px;line-height:1.5}.tip b{color:var(--cyan);font-weight:600}
.collection{margin-top:20px;border:1px solid var(--line);background:#10131d;border-radius:16px;padding:18px 20px}.collection-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.collection-head h3{font-size:13px;margin:0}.collection-head span{font:10px 'DM Mono',monospace;color:#929aae}.cards{display:grid;grid-template-columns:repeat(8,1fr);gap:8px}.card{min-height:95px;border:1px solid #292f40;border-radius:10px;background:#151927;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;position:relative;overflow:hidden}.card:before{content:'';position:absolute;left:20%;right:20%;top:0;height:1px;background:var(--rarity);opacity:.8}.card .emoji{font-size:25px;filter:grayscale(1);opacity:.25}.card .name{font-size:9px;color:#737b90;text-align:center}.card .chance{font:8px 'DM Mono',monospace;color:#636c80}.card.owned{border-color:color-mix(in srgb,var(--rarity),transparent 55%);background:color-mix(in srgb,var(--rarity),#151927 94%)}.card.owned .emoji{filter:none;opacity:1}.card.owned .name{color:#e4e6ed}.card.owned .chance{color:var(--rarity)}.card.new:after{content:'NEW';position:absolute;top:5px;right:5px;font:7px 'DM Mono',monospace;color:#10130a;background:var(--lime);padding:2px 4px;border-radius:3px}.toast{position:fixed;top:22px;left:50%;transform:translate(-50%,-120px);background:#d5ff5f;color:#11150a;padding:12px 18px;border-radius:10px;font-weight:700;font-size:12px;z-index:4;transition:transform .4s}.toast.show{transform:translate(-50%,0)}footer{text-align:center;color:#555d70;font:9px 'DM Mono',monospace;padding:21px 0 0;letter-spacing:.5px}
@keyframes spin{to{transform:rotate(360deg)}}@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}@keyframes shake{0%,100%{transform:translate(0,0) scale(1)}20%{transform:translate(-7px,2px) scale(1.04)}40%{transform:translate(6px,-3px) scale(.97)}60%{transform:translate(-4px,-2px) scale(1.03)}80%{transform:translate(4px,3px) scale(.99)}}@keyframes burst{0%{transform:scale(.45);opacity:.15;filter:blur(5px)}65%{transform:scale(1.16)}100%{transform:scale(1);opacity:1;filter:blur(0)}}.rolling .orb-face{animation:shake .14s infinite}.reveal .orb-face{animation:burst .55s cubic-bezier(.2,.8,.2,1)}.reveal .orb-ring{border-color:var(--rarity);box-shadow:0 0 60px color-mix(in srgb,var(--rarity),transparent 70%),inset 0 0 40px color-mix(in srgb,var(--rarity),transparent 85%)}
@media(max-width:760px){.wrap{padding:18px 15px 35px}.game{grid-template-columns:1fr}.stage{min-height:370px}.sidebar{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.side-head{grid-column:1/-1}.odds-title{grid-column:1/-1}.odds{grid-column:1/-1;grid-template-columns:1fr 1fr}.tip{grid-column:1/-1}.cards{grid-template-columns:repeat(4,1fr)}.hero h1{letter-spacing:-2.5px}.top-right .pill:first-child{display:none}}
</style></head>
<body><div class="toast" id="toast"></div><main class="wrap">
<header class="top"><div class="brand"><div class="brand-icon">🌀</div><div>brainrot rng<small>THE INTERNET IS IN YOUR HANDS</small></div></div><div class="top-right"><div class="pill">COLLECTION <b id="top-count">0 / 16</b></div><div class="pill">TOTAL ROLLS <b id="top-rolls">0</b></div><button class="sound" id="sound" title="Toggle sound">♫</button></div></header>
<section class="hero"><div class="eyebrow">✳ &nbsp; roll into the unknown &nbsp; ✳</div><h1>How cooked<br>is your <span>luck?</span></h1><p>One roll. Infinite brainrot. What will the algorithm bless you with?</p></section>
<section class="game"><div class="stage idle" id="stage"><div class="stage-top"><span>⦿ &nbsp; CHAOS CHAMBER</span><span class="live">● &nbsp; RNG ACTIVE</span></div><div class="orb" id="orb"><div class="orb-ring"></div><div class="orb-face" id="face">🌀</div></div><h2 id="result">Ready to get cooked?</h2><p class="sub" id="sub">Press roll and let fate decide.</p><button class="roll" id="roll">✦ &nbsp; ROLL FOR BRAINROT</button><div class="hint">[ SPACE ] TO ROLL</div></div>
<aside class="sidebar"><div class="side-head"><h3>Your stats</h3><span>PLAYER 001</span></div><div class="stat"><span>Total rolls</span><b id="rolls">0</b></div><div class="stat"><span>Unique finds</span><b class="green" id="unique">0 / 16</b></div><div class="stat"><span>Best pull</span><b id="best">—</b></div><div class="stat"><span>Luck streak</span><b id="streak">0 🔥</b></div><div class="odds-title">ROLL ODDS</div><div class="odds" id="odds"></div><div class="tip"><b>✦ Collector tip</b><br>Every character has a different chance. Keep rolling to fill your collection!</div></aside></section>
<section class="collection"><div class="collection-head"><h3>✳ &nbsp; The collection</h3><span id="progress">0 of 16 discovered</span></div><div class="cards" id="cards"></div></section><footer>100% UNHINGED &nbsp; · &nbsp; 0% SERIOUS &nbsp; · &nbsp; PROGRESS SAVES ON THIS DEVICE</footer></main>
<script>
const characters=[
 {name:'Lil Bro',emoji:'🗿',rarity:'Common',chance:1,color:'#a8b0c0',weight:450},
 {name:'Yap Machine',emoji:'🗣️',rarity:'Common',chance:1,color:'#a8b0c0',weight:250},
 {name:'Rizzler',emoji:'😎',rarity:'Uncommon',chance:2,color:'#66d7ac',weight:130},
 {name:'Chill Guy',emoji:'🐶',rarity:'Uncommon',chance:3,color:'#66d7ac',weight:75},
 {name:'Mewing Streak',emoji:'🧏',rarity:'Rare',chance:5,color:'#64a9ff',weight:40},
 {name:'Fanum Tax',emoji:'🍟',rarity:'Rare',chance:8,color:'#64a9ff',weight:25},
 {name:'Ohio Final Boss',emoji:'👹',rarity:'Epic',chance:15,color:'#b883ff',weight:14},
 {name:'Sigma Spreadsheet',emoji:'📈',rarity:'Epic',chance:25,color:'#b883ff',weight:8},
 {name:'Skibidi Oracle',emoji:'🚽',rarity:'Legendary',chance:50,color:'#ffca61',weight:4},
 {name:'Ancient Kneedos',emoji:'🦵',rarity:'Legendary',chance:80,color:'#ffca61',weight:3},
 {name:'Chronically Online',emoji:'📱',rarity:'Mythic',chance:150,color:'#ff78c7',weight:2},
 {name:'Giga Yap Titan',emoji:'🗿',rarity:'Mythic',chance:300,color:'#ff78c7',weight:1.4},
 {name:'Cursed Group Chat',emoji:'👁️',rarity:'Secret',chance:750,color:'#ff5d6c',weight:.7},
 {name:'The Algorithm',emoji:'🌀',rarity:'Secret',chance:1500,color:'#ff5d6c',weight:.35},
 {name:'Touch Grass.exe',emoji:'🌱',rarity:'Transcendent',chance:5000,color:'#d5ff5f',weight:.1},
 {name:'???',emoji:'🛸',rarity:'Transcendent',chance:10000,color:'#d5ff5f',weight:.02}
];
const rarities=[['Common','#a8b0c0','1 in 1'],['Uncommon','#66d7ac','1 in 2'],['Rare','#64a9ff','1 in 5'],['Epic','#b883ff','1 in 15'],['Legendary','#ffca61','1 in 50'],['Mythic','#ff78c7','1 in 150'],['Secret','#ff5d6c','1 in 750'],['Transcendent','#d5ff5f','1 in 5,000']];
let save={rolls:0,owned:{},best:0,streak:0};try{save={...save,...JSON.parse(localStorage.brainrotSave||'{}')}}catch{}
const $=id=>document.getElementById(id), cards=$('cards'),stage=$('stage');let busy=false,soundOn=true,audio;
function render(){cards.innerHTML=characters.map((c,i)=>{let count=save.owned[i]||0;return `<div class="card ${count?'owned':''}" style="--rarity:${c.color}" title="${count?count+' found':'Undiscovered'}"><div class="emoji">${count?c.emoji:'?'}</div><div class="name">${count?c.name:'???'}</div><div class="chance">${count?'×'+count:'1 / '+c.chance.toLocaleString()}</div></div>`}).join('');let unique=Object.keys(save.owned).length;$('top-count').textContent=`${unique} / ${characters.length}`;$('top-rolls').textContent=save.rolls.toLocaleString();$('rolls').textContent=save.rolls.toLocaleString();$('unique').textContent=`${unique} / ${characters.length}`;$('best').textContent=save.best?characters[save.best-1].rarity:'—';$('streak').textContent=save.streak+' 🔥';$('progress').textContent=`${unique} of ${characters.length} discovered`;}
$('odds').innerHTML=rarities.map(([name,color,chance])=>`<div class="odds-row"><span class="rarity"><i class="dot" style="--rarity:${color}"></i>${name}</span><code>${chance}</code></div>`).join('');render();
function choose(){let total=characters.reduce((s,c)=>s+c.weight,0),n=Math.random()*total;for(let i=0;i<characters.length;i++){n-=characters[i].weight;if(n<=0)return i}return 0}
function tone(freq,duration=.09,type='sine'){if(!soundOn)return;try{audio??=new(window.AudioContext||window.webkitAudioContext)();let o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.value=freq;g.gain.setValueAtTime(.045,audio.currentTime);g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+duration);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+duration)}catch{}}
function roll(){if(busy)return;busy=true;let button=$('roll'),face=$('face');button.disabled=true;button.textContent='⟳  THE ALGORITHM IS COOKING…';stage.classList.remove('reveal');stage.classList.add('rolling');$('result').textContent='Calculating your fate…';$('sub').textContent='The brainrot dimension is loading.';let ticks=0;let spin=setInterval(()=>{face.textContent=characters[Math.floor(Math.random()*characters.length)].emoji;tone(220+ticks*15,.035,'triangle');ticks++},85);setTimeout(()=>{clearInterval(spin);let i=choose(),c=characters[i],isNew=!save.owned[i];save.rolls++;save.owned[i]=(save.owned[i]||0)+1;save.streak=c.chance>=50?save.streak+1:0;if(c.chance>save.best)save.best=c.chance;stage.classList.remove('rolling');stage.classList.add('reveal');stage.style.setProperty('--rarity',c.color);face.textContent=c.emoji;$('result').textContent=c.name;$('result').style.color=c.color;$('sub').textContent=`${c.rarity.toUpperCase()}  ·  1 in ${c.chance.toLocaleString()}${isNew?'  ·  NEW DISCOVERY!':''}`;button.disabled=false;button.innerHTML='✦ &nbsp; ROLL AGAIN';busy=false;render();localStorage.brainrotSave=JSON.stringify(save);tone(c.chance>=50?880:520,.25,'sine');if(isNew){$('toast').textContent=`✦ NEW DISCOVERY: ${c.name}!`;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2100)}},1500)}
$('roll').addEventListener('click',roll);document.addEventListener('keydown',e=>{if(e.code==='Space'&&e.target.tagName!=='BUTTON'){e.preventDefault();roll()}});$('sound').onclick=()=>{soundOn=!soundOn;$('sound').textContent=soundOn?'♫':'♩';$('sound').style.color=soundOn?'':'#666'};
</script></body></html>
